const bibleLoading = {};
function loadBible(lang) {
  const key = lang === 'en' ? 'BIBLE_EN' : 'BIBLE_KO';
  if (window[key]) return Promise.resolve(true);
  if (!bibleLoading[lang]) {
    bibleLoading[lang] = new Promise(resolve => {
      const s = document.createElement('script');
      s.src = `data/bible-${lang}.js`;
      s.onload = () => resolve(!!window[key]);
      s.onerror = () => { bibleLoading[lang] = null; s.remove(); resolve(false); };
      document.head.appendChild(s);
    });
  }
  return bibleLoading[lang];
}

function bibleData(lang) { return lang === 'en' ? window.BIBLE_EN : window.BIBLE_KO; }

// 여러 절을 한 문장으로 합침. 범위를 벗어나면 null
function getPassage(lang, p) {
  const data = bibleData(lang);
  if (!data || !p) return null;
  const ch = data[p.book] && data[p.book][p.chapter - 1];
  if (!ch || !ch.length) return null;
  const list = p.verses.length ? p.verses : ch.map((_, i) => i + 1);
  const parts = [];
  let prev = null;
  for (const v of list) {
    let t = ch[v - 1];
    if (t === undefined) return null;
    t = t.replace(/^\(\d+-\d+\)\s*/, ''); // 개역한글의 "(18-19)" 같은 합본 절 표시
    if (!t || t === prev) continue;
    parts.push(t);
    prev = t;
  }
  if (!parts.length) return null;
  let text = parts.join(' ');
  if (lang === 'en' && (text.match(/"/g) || []).length % 2 === 1) {
    // 인용문 중간부터 시작/끝나는 구절의 짝 없는 따옴표 제거 (예: 요 3:16)
    if (text.startsWith('"')) text = text.slice(1);
    else if (text.endsWith('"')) text = text.slice(0, -1);
  }
  return text;
}

