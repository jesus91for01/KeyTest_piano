function checkTyping() {
  const target = current.text;
  let typed = userInput.value;
  if (!startTime && typed.length > 0) { startTime = Date.now(); statTimer = setInterval(refreshStats, 1000); }
  if (typed.length > target.length) { typed = typed.substring(0, target.length); userInput.value = typed; }
  if (typed.length === target.length) {
    if (!endTime) { endTime = Date.now(); clearInterval(statTimer); }
  } else if (endTime) {
    endTime = null; clearInterval(statTimer); statTimer = setInterval(refreshStats, 1000);
  }
  renderTyping();
  if (typed.length === target.length) {
    feedbackMsg.classList.add('show');
    btnMobileNext.style.display = 'block';
    if (typed === target) {
      feedbackMsg.innerHTML = repeatToggle.checked
        ? '✨ <strong>[Enter]</strong>를 누르면 이 구절을 한 번 더 연습합니다.'
        : '✨ 완벽합니다! <strong>[Enter]</strong>를 눌러 넘어가세요.';
