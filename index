      const d = JSON.parse(ev.target.result);
      if (Array.isArray(d)) {
        if (confirm('기존 데이터를 지우고 백업 파일로 덮어씌우시겠습니까?\n\n[확인] : 기존 데이터 삭제 후 복원\n[취소] : 기존 데이터에 추가 (병합)')) {
