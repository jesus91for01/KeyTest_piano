// 한글 음절의 실제 타자 수 (쌍자음·겹모음·겹받침은 2타)
function keyCount(c) {
  const x = c.charCodeAt(0);
  if (x >= 0xAC00 && x <= 0xD7A3) {
    const o = x - 0xAC00, jong = o % 28, jung = ((o - jong) / 28) % 21, cho = Math.floor(((o - jong) / 28) / 21);
    let n = [1, 4, 8, 10, 24].includes(cho) ? 2 : 1;
    n += [3, 7, 9, 10, 11, 14, 15, 16, 19].includes(jung) ? 2 : 1;
    if (jong > 0) n += [2, 3, 5, 6, 9, 10, 11, 12, 13, 14, 15, 18, 20].includes(jong) ? 2 : 1;
    return n;
  }
  return 1;
}
function updateStats(keys, correct, typedLen) {
  if (!startTime) return;
  const t = endTime || Date.now(), minutes = Math.max((t - startTime) / 60000, 0.0166);
  wpmDisplay.innerText = Math.round(keys / minutes);
  accuracyDisplay.innerText = typedLen > 0 ? Math.round((correct / typedLen) * 100) : 100;
}
function refreshStats() {
  if (!current) return;
  const target = current.text, typed = userInput.value;
  let correct = 0, keys = 0;
  for (let i = 0; i < typed.length; i++) if (typed[i] === target[i]) { correct++; keys += keyCount(typed[i]); }
  updateStats(keys, correct, typed.length);
}

// ===== 키보드 테스트 =====
// 배열 단위: 키 1개 = 1칸. 전체 22.5 x 6.5칸 (풀배열 104키 + 한/영·한자)
const KB_W = 22.5, KB_H = 6.5;
const KB_KEYS = [];
const JAMO = { Q:'ㅂ',W:'ㅈ',E:'ㄷ',R:'ㄱ',T:'ㅅ',Y:'ㅛ',U:'ㅕ',I:'ㅑ',O:'ㅐ',P:'ㅔ',A:'ㅁ',S:'ㄴ',D:'ㅇ',F:'ㄹ',G:'ㅎ',H:'ㅗ',J:'ㅓ',K:'ㅏ',L:'ㅣ',Z:'ㅋ',X:'ㅌ',C:'ㅊ',V:'ㅍ',B:'ㅠ',N:'ㅜ',M:'ㅡ' };
const two = (top, main) => `<small>${top}</small>${main}`;
const letters = s => s.split('').map(c => ['Key' + c, `${c}<small>${JAMO[c]}</small>`]);
const fkeys = (a, b) => { const r = []; for (let i = a; i <= b; i++) r.push(['F' + i, 'F' + i]); return r; };
// 숫자 = 앞 칸 띄우기, [코드(여러 개는 공백 구분), 표시, 너비, 높이]
function kbRow(y, keys) {
  let x = 0;
  keys.forEach(k => {
    if (typeof k === 'number') { x += k; return; }
    const [codes, label, w = 1, h = 1] = k;
    KB_KEYS.push({ codes: codes.split(' '), label, x, y, w, h });
    x += w;
  });
}
kbRow(0, [['Escape', 'Esc'], 1, ...fkeys(1, 4), .5, ...fkeys(5, 8), .5, ...fkeys(9, 12), .25,
  ['PrintScreen', 'Prt Sc'], ['ScrollLock', 'Scroll<br>Lock'], ['Pause', 'Pause']]);
kbRow(1.5, [['Backquote', two('~', '`')], ...'1234567890'.split('').map((d, i) => ['Digit' + d, two('!@#$%^&*()'[i], d)]),
  ['Minus', two('_', '-')], ['Equal', two('+', '=')], ['Backspace', 'Backspace', 2], .25,
  ['Insert', 'Insert'], ['Home', 'Home'], ['PageUp', 'Page<br>Up'], .25,
  ['NumLock', 'Num<br>Lock'], ['NumpadDivide', '/'], ['NumpadMultiply', '*'], ['NumpadSubtract', '-']]);
kbRow(2.5, [['Tab', 'Tab', 1.5], ...letters('QWERTYUIOP'), ['BracketLeft', two('{', '[')], ['BracketRight', two('}', ']')], ['Backslash', two('|', '\\'), 1.5], .25,
  ['Delete', 'Delete'], ['End', 'End'], ['PageDown', 'Page<br>Down'], .25,
  ['Numpad7', '7'], ['Numpad8', '8'], ['Numpad9', '9'], ['NumpadAdd', '+', 1, 2]]);
kbRow(3.5, [['CapsLock', 'Caps Lock', 1.75], ...letters('ASDFGHJKL'), ['Semicolon', two(':', ';')], ['Quote', two('"', "'")], ['Enter', 'Enter', 2.25], 3.5,
  ['Numpad4', '4'], ['Numpad5', '5'], ['Numpad6', '6']]);
kbRow(4.5, [['ShiftLeft', 'Shift', 2.25], ...letters('ZXCVBNM'), ['Comma', two('&lt;', ',')], ['Period', two('&gt;', '.')], ['Slash', two('?', '/')], ['ShiftRight', 'Shift', 2.75], 1.25,
  ['ArrowUp', '↑'], 1.25, ['Numpad1', '1'], ['Numpad2', '2'], ['Numpad3', '3'], ['NumpadEnter', 'Enter', 1, 2]]);
kbRow(5.5, [['ControlLeft', 'Ctrl', 1.25], ['MetaLeft', 'Win', 1.25], ['AltLeft', 'Alt', 1.25], ['Space', 'Space', 6.25],
  ['AltRight Lang1', '한/영<small>Alt</small>', 1.25], ['MetaRight', 'Win', 1.25], ['ContextMenu', 'Menu', 1.25], ['ControlRight Lang2', '한자<small>Ctrl</small>', 1.25], .25,
  ['ArrowLeft', '←'], ['ArrowDown', '↓'], ['ArrowRight', '→'], .25, ['Numpad0', '0', 2], ['NumpadDecimal', '.']]);

const kbCodeMap = {};
KB_KEYS.forEach(k => k.codes.forEach(c => { kbCodeMap[c] = k; }));
const KB_KEYCODE_FALLBACK = { 21: 'Lang1', 25: 'Lang2' }; // 한/영, 한자 (code가 비어 있는 경우)
const kbPressed = new Set(), kbTested = new Set(), kbExtra = new Set();
let kbBuilt = false, kbMaxHeld = 0, kbHistory = [];

function buildKeyboard() {
  if (kbBuilt) return;
  const board = $('keyboard');
  KB_KEYS.forEach(k => {
    const d = el('div', 'key');
    d.style.left = (k.x / KB_W * 100) + '%';
    d.style.top = (k.y / KB_H * 100) + '%';
    d.style.width = (k.w / KB_W * 100) + '%';
    d.style.height = (k.h / KB_H * 100) + '%';
    const face = el('span');
    face.innerHTML = k.label;
    d.appendChild(face);
    board.appendChild(d);
    k.el = d;
  });
  kbBuilt = true;
  updateKbStats();
}
function kbFind(e) { return kbCodeMap[e.code] || kbCodeMap[KB_KEYCODE_FALLBACK[e.keyCode]] || null; }
function kbKeyId(e, k) { return k ? k.codes[0] : (e.code || e.key || `keyCode ${e.keyCode}`); }
function kbActive() { return secKeyboard.style.display === 'block'; }
function kbMarkTested(e, k) {
  if (k) {
    kbTested.add(k.codes[0]);
    k.el.classList.add('tested');
  } else {
    const id = kbKeyId(e, k);
    if (!kbExtra.has(id)) {
      kbExtra.add(id);
      $('kb-extra-list').appendChild(el('span', 'chip', id));
      $('kb-extra').style.display = 'block';
    }
  }
}
function updateKbStats() {
  $('kb-held').textContent = `${kbPressed.size} (${kbMaxHeld})`;
  $('kb-count').textContent = `${kbTested.size} / ${KB_KEYS.length}`;
  $('kb-progress-bar').style.width = (kbTested.size / KB_KEYS.length * 100) + '%';
}
function updateKbLocks(e) {
  [['CapsLock', 'kb-lock-caps'], ['NumLock', 'kb-lock-num'], ['ScrollLock', 'kb-lock-scroll']].forEach(([m, id]) => {
    if (e.getModifierState) $(id).classList.toggle('on', e.getModifierState(m));
  });
}
window.addEventListener('keydown', e => {
  if (!kbActive()) return;
  e.preventDefault(); // Tab·F5·Space 등 브라우저 동작 막기
  const k = kbFind(e), id = kbKeyId(e, k);
  kbPressed.add(id);
  kbMaxHeld = Math.max(kbMaxHeld, kbPressed.size);
  if (k) k.el.classList.add('pressed');
  kbMarkTested(e, k);
  $('kb-last-key').textContent = e.key === ' ' ? 'Space' : (e.key || '-');
  $('kb-last-code').textContent = `${e.code || '-'} / ${e.keyCode}`;
  if (!e.repeat) {
    kbHistory.push(e.key === ' ' ? '␣' : e.key.length === 1 ? e.key : `[${e.key}]`);
    if (kbHistory.length > 30) kbHistory.shift();
    $('kb-history').textContent = '입력 기록: ' + kbHistory.join(' ');
  }
  updateKbLocks(e);
  updateKbStats();
}, true);
window.addEventListener('keyup', e => {
  if (!kbActive()) return;
  e.preventDefault();
  const k = kbFind(e);
  kbPressed.delete(kbKeyId(e, k));
  if (k) k.el.classList.remove('pressed');
  kbMarkTested(e, k); // Print Screen은 keyup만 들어옴
  updateKbLocks(e);
  updateKbStats();
}, true);
window.addEventListener('blur', () => {
  kbPressed.clear();
  KB_KEYS.forEach(k => {
    if (k.el) k.el.classList.remove('pressed');
    if (k.miniEl) k.miniEl.classList.remove('pressed');
  });
  if (kbBuilt) updateKbStats();
});

// ===== 연습 화면의 '키보드 보기' (기능키·숫자패드 없이 타자용 자판만) =====
const kbViewToggle = $('kbview-toggle');
const MINI_KEYS = KB_KEYS.filter(k => k.y >= 1.5 && k.x < 15);
let miniBuilt = false;
function buildMiniKeyboard() {
