const PSALMS = 18;
const normName = s => s.toLowerCase().replace(/[\s.]/g, '');
const BOOK_INDEX = {};
BOOKS.forEach((b, i) => b.forEach(n => { BOOK_INDEX[normName(n)] = i; }));
Object.entries({
  '아가서':'아가', '계시록':'요한계시록',
  'psalms':'시편', 'ps':'시편', 'songofsongs':'아가', 'song':'아가', 'gen':'창세기', 'ex':'출애굽기', 'matt':'마태복음',
  'rom':'로마서', 'heb':'히브리서', 'rev':'요한계시록', 'jn':'요한복음'
}).forEach(([alias, name]) => { BOOK_INDEX[normName(alias)] = BOOK_INDEX[normName(name)]; });

// "요 3:16", "롬 8:28~30", "시편 119:9,11", "시 23편", "요한복음 3장 16절", "1 John 3:16" 등을 해석
function parseRef(str) {
  if (!str) return null;
  const s = str.replace(/：/g, ':').replace(/\s+/g, ' ').trim()
    .replace(/^요한\s*([123])\s*서/, (_, n) => '요한' + '일이삼'[n - 1] + '서');
  const m = s.match(/^(\d?\s*[^\d]+?)\s*(\d+)\s*(?:장|편)?\s*(?:[:.]\s*)?([\d\s,~\-–―절]*)$/);
  if (!m) return null;
  const book = BOOK_INDEX[normName(m[1])];
  if (book === undefined) return null;
  const spec = m[3].replace(/[\s절]/g, '');
  const verses = [];
  for (const part of spec.split(',')) {
    if (!part) continue;
    const r = part.match(/^(\d+)(?:[~\-–―](\d+))?$/);
    if (!r) return null;
    const a = +r[1], b = r[2] ? +r[2] : a;
    if (a < 1 || b < a) return null;
    for (let v = a; v <= b; v++) if (!verses.includes(v)) verses.push(v);
  }
  return { book, chapter: +m[2], verses }; // verses가 비어 있으면 장 전체
}

// 연속된 절은 묶어서 표기: [16,17] → "16,17", [7,8,9] → "7~9"
function formatVerseSpec(verses, lang) {
  const groups = [];
  verses.forEach(v => {
    const g = groups[groups.length - 1];
    if (g && v === g[1] + 1) g[1] = v; else groups.push([v, v]);
  });
  const dash = lang === 'en' ? '-' : '~';
  return groups.map(([a, b]) => a === b ? `${a}` : b === a + 1 ? `${a},${b}` : `${a}${dash}${b}`).join(',');
}

function formatRef(p, lang) {
  const name = lang === 'en' ? BOOKS[p.book][2] : BOOKS[p.book][0];
  if (p.verses.length) return `${name} ${p.chapter}:${formatVerseSpec(p.verses, lang)}`;
  if (lang === 'en') return `${name} ${p.chapter}`;
  return `${name} ${p.chapter}${p.book === PSALMS ? '편' : '장'}`;
}

