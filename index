    const start = e.off + 30 + d.getUint16(e.off + 26, true) + d.getUint16(e.off + 28, true);
    const data = new Uint8Array(buf, start, e.size);
    if (e.method === 0) return decodeXmlBytes(data);
    if (e.method !== 8) throw new Error('지원하지 않는 .mxl 압축 방식입니다.');
    if (!window.DecompressionStream) throw new Error('이 브라우저는 .mxl 압축 풀기를 지원하지 않습니다. 악보 프로그램에서 .musicxml(비압축)로 저장해 주세요.');
    const out = await new Response(new Blob([data]).stream().pipeThrough(new DecompressionStream('deflate-raw'))).arrayBuffer();
    return decodeXmlBytes(new Uint8Array(out));
  };
