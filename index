<style>:root{--bg-color:#f3f4f6;--box-bg:#ffffff;--primary-color:#3b82f6;--text-untyped:#9ca3af;--text-typed:#1f2937;--text-error:#ef4444;--bg-error:rgba(239,68,68,0.2);--caret-color:#fbbf24;--border-color:#e5e7eb;--ui-text:#6b7280}[data-theme="dark"]{--bg-color:#111827;--box-bg:#1f2937;--text-untyped:#4b5563;--text-typed:#f3f4f6;--text-error:#f87171;--bg-error:rgba(248,113,113,0.25);--caret-color:#fbbf24;--border-color:#374151;--ui-text:#9ca3af}body{font-family:'Pretendard',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;background-color:var(--bg-color);color:var(--ui-text);margin:0;padding:20px;transition:background-color .4s ease,color .4s ease;line-height:1.6}header{display:flex;justify-content:space-between;align-items:center;max-width:900px;margin:0 auto 30px}header h1{margin:0;font-size:1.2em;font-weight:600;letter-spacing:-.5px;color:var(--text-typed)}nav{max-width:900px;margin:0 auto 40px;display:flex;gap:15px;border-bottom:1px solid var(--border-color);padding-bottom:10px}button{background:0 0;border:none;cursor:pointer;font-family:inherit;font-size:1rem;color:var(--ui-text);transition:all .2s}#theme-toggle{font-size:.9em;padding:5px 10px;border-radius:4px;background-color:var(--box-bg);border:1px solid var(--border-color)}.header-btns{display:flex;gap:10px;align-items:center}#help-toggle{font-size:.9em;padding:5px 10px;border-radius:4px;background-color:var(--box-bg);border:1px solid var(--border-color)}#help-toggle:hover,#theme-toggle:hover{background-color:var(--bg-color)}.modal-overlay{position:fixed;top:0;left:0;width:100%;height:100%;background-color:rgba(0,0,0,.5);display:none;justify-content:center;align-items:center;z-index:1000;opacity:0;animation:modalFadeIn .2s forwards}.modal-overlay.show{display:flex;opacity:1}.modal-content{background-color:var(--box-bg);color:var(--text-typed);width:90%;max-width:500px;max-height:85vh;overflow-y:auto;padding:30px;border-radius:12px;box-shadow:0 10px 25px rgba(0,0,0,.1);position:relative}.modal-content h2{margin-top:0;color:var(--primary-color);border-bottom:2px solid var(--border-color);padding-bottom:10px}.modal-content h3{font-size:1.1em;margin-top:25px;margin-bottom:10px;color:var(--text-typed)}.modal-content p,.modal-content ul{font-size:.95em;color:var(--ui-text);line-height:1.6}.modal-content ul{padding-left:20px}.modal-content li{margin-bottom:8px}.close-modal-btn{background-color:var(--text-typed);color:var(--box-bg);border:none;padding:10px 20px;border-radius:6px;font-weight:700;width:100%;margin-top:20px;cursor:pointer}@keyframes modalFadeIn{from{opacity:0;transform:translateY(-10px)}to{opacity:1;transform:translateY(0)}}nav button{padding:5px 0;font-weight:500;position:relative}nav button.active{color:var(--text-typed);font-weight:700}nav button.active::after{content:'';position:absolute;bottom:-11px;left:0;width:100%;height:2px;background-color:var(--primary-color)}main{max-width:900px;margin:0 auto}#section-manage{background-color:var(--box-bg);padding:30px;border-radius:12px;box-shadow:0 4px 20px rgba(0,0,0,.03)}.manage-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:25px;flex-wrap:wrap;gap:15px}.manage-header h2{margin:0;color:var(--text-typed);font-size:1.4em}.data-btns{display:flex;gap:10px}.data-btn{background-color:var(--bg-color);color:var(--text-typed);border:1px solid var(--border-color);padding:8px 14px;font-size:.9em;border-radius:6px;font-weight:600}.data-btn:hover{background-color:var(--border-color)}.input-group{display:flex;flex-direction:column;gap:15px;margin-bottom:40px}input[type="text"],textarea,select{padding:15px;border:1px solid var(--border-color);border-radius:8px;background-color:var(--bg-color);color:var(--text-typed);font-size:1rem;font-family:inherit;outline:0;transition:border-color .2s}input[type="text"]:focus,textarea:focus,select:focus{border-color:var(--primary-color)}textarea{resize:vertical;min-height:100px}#add-verse-btn{background-color:var(--primary-color);color:#fff;padding:15px;border-radius:8px;font-weight:600}#add-verse-btn:hover{background-color:#2563eb}#verse-list{padding:0;margin:0}details.chapter-details{margin-bottom:15px;border:1px solid var(--border-color);border-radius:8px;background-color:var(--box-bg);overflow:hidden;box-shadow:0 2px 4px rgba(0,0,0,.02)}summary.chapter-header{font-size:1.05em;font-weight:700;color:var(--primary-color);padding:15px 20px;cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center;background-color:var(--box-bg);transition:background-color .2s}summary.chapter-header:hover{background-color:var(--bg-color)}summary.chapter-header::-webkit-details-marker{display:none}summary.chapter-header::after{content:'▼';font-size:.8em;color:var(--ui-text);transition:transform .3s ease}details[open] summary.chapter-header::after{transform:rotate(180deg)}details[open] summary.chapter-header{border-bottom:1px solid var(--border-color)}details.chapter-details ul{list-style:none;padding:0;margin:0;background-color:var(--bg-color)}details.chapter-details li.verse-item{display:flex;justify-content:space-between;align-items:flex-start;padding:15px 20px;border-bottom:1px dashed var(--border-color);gap:20px}details.chapter-details li.verse-item:last-child{border-bottom:none}.verse-info strong{color:var(--text-typed);display:block;margin-bottom:5px}.verse-info span{color:var(--ui-text);line-height:1.5}.action-btns{display:flex;flex-direction:column;gap:8px;min-width:65px}.repeat-btn,.delete-btn{background-color:var(--box-bg);font-size:.85em;padding:6px 10px;border-radius:6px;width:100%;border:1px solid;transition:all .2s}.repeat-btn{color:var(--primary-color);border-color:var(--primary-color)}.repeat-btn:hover{background-color:var(--primary-color);color:#fff}.delete-btn{color:var(--text-error);border-color:var(--text-error)}.delete-btn:hover{background-color:var(--text-error);color:#fff;text-decoration:none}.practice-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:40px;font-size:.95em}.chapter-selector select{padding:6px 12px;font-weight:600;background-color:transparent;border:1px solid var(--border-color);border-radius:4px}.minimal-stats{display:flex;gap:20px;font-family:monospace;font-size:1.1em;color:var(--ui-text)}.minimal-stats strong{color:var(--text-typed);font-weight:400}.toggles-group{display:flex;gap:15px;align-items:center;flex-wrap:wrap}.typing-container{position:relative;margin-top:20px;cursor:text}#current-ref{color:var(--primary-color);margin-bottom:20px;font-size:1.1em;font-weight:600}.typing-area{font-size:2.2em;line-height:1.7;letter-spacing:-.5px;white-space:pre-wrap;word-break:keep-all;position:relative;min-height:200px}.typing-area span{color:var(--text-untyped);transition:color .1s ease;position:relative}.typing-area span.correct{color:var(--text-typed)}.typing-area span.incorrect{color:var(--text-error);background-color:var(--bg-error);border-radius:3px;position:relative}.typing-area span.incorrect::after{content:attr(data-typed);position:absolute;top:100%;left:50%;transform:translateX(-50%);font-size:.55em;line-height:1;margin-top:4px;color:var(--text-error);font-weight:700;pointer-events:none;text-shadow:none}@keyframes blink{0%,100%{opacity:1}50%{opacity:0}}.typing-area span.current-char::before{content:'';position:absolute;left:-2px;top:10%;height:80%;width:3px;background-color:var(--caret-color);animation:blink 1s infinite;border-radius:2px}.typing-area span.end-caret::before{left:0}.typing-area.blind-mode span:not(.correct):not(.current-char):not(.composing){color:transparent!important;text-shadow:0 0 12px var(--text-untyped)}.typing-area span.composing{color:var(--text-typed);border-bottom:2px solid var(--text-typed)}.hidden-textarea{position:absolute;top:0;left:0;width:100%;height:100%;opacity:0;z-index:10;cursor:text;resize:none;color:transparent;background:transparent;border:none;outline:0;font-size:16px}.feedback-msg{text-align:left;font-size:1.1em;color:var(--ui-text);margin-top:30px;min-height:30px;opacity:0;transition:opacity .3s}.feedback-msg.show{opacity:1}.empty-state{text-align:center;padding:60px 20px;color:var(--ui-text)}#section-results{background-color:var(--box-bg);padding:40px;border-radius:12px;box-shadow:0 4px 20px rgba(0,0,0,.03)}.results-list{list-style:none;padding:0;margin:30px 0}.results-list li{padding:20px 0;border-bottom:1px dashed var(--border-color)}.results-list .verse-ref{color:var(--primary-color);font-weight:600;display:block;margin-bottom:5px}.results-list .verse-text{display:block;font-size:1.1em;color:var(--text-typed);margin-bottom:10px}.results-list .verse-stats{font-family:monospace;color:var(--ui-text);font-size:.95em}#btn-back-to-manage{background-color:var(--text-typed);color:var(--box-bg);padding:12px 25px;border-radius:6px;font-weight:600;display:block;margin:0 auto}#btn-back-to-manage:hover{opacity:.8}.btn-mobile-next{display:none;width:100%;background-color:var(--primary-color);color:#fff;padding:15px;margin-top:15px;border-radius:8px;font-weight:700;font-size:1.1em;text-align:center;border:none;cursor:pointer;animation:fadeIn .3s}@keyframes fadeIn{from{opacity:0;transform:translateY(-10px)}to{opacity:1;transform:translateY(0)}}.verse-nav-btns{display:flex;justify-content:space-between;margin-top:30px;padding-top:20px;border-top:1px dashed var(--border-color)}.nav-btn{color:var(--ui-text);font-size:.95em;padding:8px 15px;border-radius:6px;background-color:var(--box-bg);border:1px solid var(--border-color);transition:all .2s}.nav-btn:hover:not(:disabled){background-color:var(--border-color);color:var(--text-typed)}.nav-btn:disabled{opacity:.3;cursor:not-allowed;border-color:transparent;background-color:transparent}@media (max-width:600px){header h1{font-size:1.1em}nav{gap:10px;margin-bottom:25px}main{padding:0;box-shadow:none;background:0 0}#section-manage,#section-results{padding:20px}.practice-header{flex-direction:column;align-items:flex-start;gap:15px}.minimal-stats{font-size:1em;width:100%;justify-content:space-between}.toggles-group{width:100%;justify-content:flex-end}.typing-area{font-size:1.5em;min-height:150px;padding:15px 0}ul#verse-list li.verse-item{flex-direction:column;gap:15px}.action-btns{flex-direction:row;width:100%;justify-content:flex-end}.repeat-btn,.delete-btn{width:auto;padding:8px 20px}}</style>
<style>
/* ===== 언어 선택 ===== */
.lang-switch{display:inline-flex;border:1px solid var(--border-color);border-radius:6px;overflow:hidden}
.lang-switch button{padding:4px 12px;font-size:.9em;font-weight:600;border-radius:0}
.lang-switch button.active{background-color:var(--primary-color);color:#fff}
#current-ref .ref-note{font-size:.75em;color:var(--ui-text);font-weight:400;margin-left:8px}
/* ===== 입력창: 커서 위치를 따라다님 (자동 스크롤) ===== */
.hidden-textarea{position:absolute;top:0;left:0;width:24px;height:1.2em;padding:0;margin:0;overflow:hidden;opacity:0;z-index:10;resize:none;border:none;outline:0;font-size:16px;color:transparent;background:transparent;caret-color:transparent;pointer-events:none}
/* ===== 성경에서 불러오기 ===== */
.bible-lookup{border:1px dashed var(--primary-color);border-radius:8px;padding:15px;background-color:var(--bg-color)}
.lookup-title{font-weight:700;color:var(--text-typed);margin-bottom:10px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:6px}
.lookup-title #lookup-status{font-weight:400;font-size:.85em;color:var(--ui-text)}
.lookup-row{display:flex;flex-wrap:wrap;gap:8px;align-items:center;color:var(--text-typed)}
.lookup-row select{padding:8px 10px;background-color:var(--box-bg)}
.lookup-row select:disabled{opacity:.5}
.lookup-hint{font-size:.85em;margin-top:10px;line-height:1.5}
.ref-row{display:flex;gap:10px}
.ref-row input{flex:1;min-width:0}
.sub-btn{background-color:var(--box-bg);border:1px solid var(--primary-color);color:var(--primary-color);padding:8px 16px;border-radius:8px;font-weight:600;white-space:nowrap}
.sub-btn:hover:not(:disabled){background-color:var(--primary-color);color:#fff}
.sub-btn:disabled{opacity:.5;cursor:not-allowed}
/* ===== 키보드 테스트 ===== */
body{--key-bg:#ffffff;--key-shadow:#d1d5db;--key-tested-bg:#d1fae5;--key-tested-text:#065f46;--key-tested-border:#34d399}
body[data-theme="dark"]{--key-bg:#374151;--key-shadow:#111827;--key-tested-bg:#064e3b;--key-tested-text:#a7f3d0;--key-tested-border:#10b981}
#section-keyboard{background-color:var(--box-bg);padding:30px;border-radius:12px;box-shadow:0 4px 20px rgba(0,0,0,.03)}
.kb-top{display:flex;justify-content:space-between;align-items:flex-start;gap:15px;flex-wrap:wrap;margin-bottom:20px}
.kb-top h2{margin:0 0 6px;color:var(--text-typed);font-size:1.4em}
.kb-top p{margin:0;font-size:.9em}
.kb-actions{display:flex;gap:10px;flex-wrap:wrap}
.via-btn{display:inline-flex;align-items:center;gap:6px;background-color:var(--primary-color);color:#fff;padding:8px 16px;border-radius:8px;font-weight:600;text-decoration:none;font-size:.95em}
.via-btn:hover{background-color:#2563eb}
.kb-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:20px}
.kb-stat{background-color:var(--bg-color);border:1px solid var(--border-color);border-radius:8px;padding:10px 14px}
.kb-stat .label{font-size:.8em;display:block}
.kb-stat .value{font-family:monospace;font-size:1.25em;color:var(--text-typed);font-weight:700;word-break:break-all}
.kb-progress{height:6px;background-color:var(--border-color);border-radius:3px;overflow:hidden;margin-top:6px}
.kb-progress div{height:100%;width:0;background-color:var(--key-tested-border);transition:width .2s}
.kb-scroll{overflow-x:auto;padding-bottom:6px}
.keyboard{position:relative;width:100%;min-width:760px;aspect-ratio:22.5/6.5;container-type:inline-size;user-select:none}
.key{position:absolute;box-sizing:border-box;padding:2px;display:block}
.key>span{display:flex;flex-direction:column;justify-content:center;align-items:center;height:100%;box-sizing:border-box;background-color:var(--key-bg);border:1px solid var(--border-color);border-bottom:3px solid var(--key-shadow);border-radius:6px;color:var(--text-typed);font-size:1.15cqw;line-height:1.15;text-align:center;white-space:pre-line;transition:background-color .08s,transform .08s}
.key small{font-size:.8em;color:var(--ui-text)}
.key.tested>span{background-color:var(--key-tested-bg);border-color:var(--key-tested-border);color:var(--key-tested-text)}
.key.tested small{color:var(--key-tested-text)}
.key.pressed>span{background-color:var(--primary-color);border-color:var(--primary-color);color:#fff;transform:translateY(2px);border-bottom-width:1px}
.key.pressed small{color:#fff}
.kb-lock{display:flex;gap:14px;margin:14px 0 0;font-size:.85em;flex-wrap:wrap}
.kb-lock span::before{content:'●';margin-right:4px;color:var(--border-color)}
.kb-lock span.on::before{color:#22c55e}
.kb-extra{margin-top:14px;font-size:.9em}
.kb-extra .chip{display:inline-block;background-color:var(--key-tested-bg);color:var(--key-tested-text);border:1px solid var(--key-tested-border);border-radius:12px;padding:2px 10px;margin:3px 4px 0 0;font-family:monospace;font-size:.9em}
.kb-history{font-family:monospace;font-size:.9em;margin-top:10px;min-height:1.4em;word-break:break-all}
.kb-note{margin-top:20px;padding:15px;border-radius:8px;background-color:var(--bg-color);border:1px dashed var(--border-color);font-size:.88em;line-height:1.6}
.kb-note ul{margin:6px 0 0;padding-left:20px}
.practice-header{flex-wrap:wrap;gap:12px 20px}
/* 언어·반복·블라인드·키보드 보기는 처음부터 둘째 줄에 (타수가 커질 때 줄이 바뀌며 흔들리지 않도록) */
.practice-header .toggles-group{flex-basis:100%;justify-content:flex-start}
.minimal-stats span{white-space:nowrap}
.toggles-group label{white-space:nowrap}
/* 타자 소리 */
.sound-ctrl{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.sound-ctrl select{padding:3px 8px;font-size:.85em;border-radius:6px}
.sound-ctrl input[type="range"]{width:80px;accent-color:var(--primary-color)}
.sound-ctrl:not(.on) input[type="range"],.sound-ctrl:not(.on) .song-ctl-toggle,.sound-ctrl:not(.song) .song-ctl{display:none}
.song-edit-btn{padding:3px 10px;font-size:.85em}
.song-progress{font-family:monospace;font-size:.85em;color:var(--primary-color)}
.song-progress.empty{font-family:inherit;color:var(--text-error)}
.keyboard.mini .key.song-hit>span{background-color:#f59e0b;border-color:#f59e0b;color:#fff}
.keyboard.mini .key.song-hit .k-note{color:#fff}
/* 곡 편집 창 */
.song-modal{max-width:640px}
.song-form{display:flex;flex-direction:column;gap:12px}
.song-form .row{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.song-form .row>select,.song-form .row>input{flex:1;min-width:0;padding:10px}
.song-form textarea{min-height:150px;font-family:inherit;line-height:1.6}
.song-form .se-key{flex:0 0 auto!important}
#se-status{font-size:.9em;color:var(--key-tested-text)}
#se-status.warn{color:var(--text-error)}
.se-btns{display:flex;gap:8px;flex-wrap:wrap}
.se-btns button{flex:1;padding:10px;border-radius:6px;font-weight:600;border:1px solid var(--border-color);background-color:var(--bg-color);color:var(--text-typed)}
.se-btns button.primary{background-color:var(--primary-color);border-color:var(--primary-color);color:#fff}
.se-btns button:disabled{opacity:.4;cursor:not-allowed}
.song-help{font-size:.85em;line-height:1.7;color:var(--ui-text);background-color:var(--bg-color);border-radius:8px;padding:12px 14px}
.se-import-row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.se-import-panel{display:flex;flex-direction:column;gap:8px;padding:12px 14px;border:1px dashed var(--primary-color);border-radius:8px;font-size:.9em;color:var(--text-typed)}
.se-import-panel label{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.se-import-panel select{padding:4px 8px;max-width:100%}
.song-help code{background-color:var(--box-bg);border:1px solid var(--border-color);border-radius:4px;padding:0 4px}
/* 계이름 표시 · 건반 연주 (키보드 보기 + 타자 소리) */
.keyboard.mini .k-label{display:flex;flex-direction:column;align-items:center}
.keyboard.mini .k-note{display:none}
.keyboard.mini.show-notes .k-label{font-size:.72em;opacity:.65}
.keyboard.mini.show-notes .k-note{display:block;order:-1;font-weight:700;font-size:1.05em;line-height:1.2}
.keyboard.mini .k-note.do{color:var(--primary-color)}
.keyboard.mini .k-note.accidental{color:var(--ui-text);font-weight:500}
.keyboard.mini .key.pressed .k-note{color:#fff}
.keyboard.mini.show-notes{touch-action:none;cursor:pointer}
.note-hint{display:none;text-align:center;font-size:.85em;margin-bottom:8px}
.practice-kb.show-notes .note-hint{display:block}
/* 연습 화면의 키보드 보기: 화면 아래에 붙어 있음 */
.practice-kb{position:sticky;bottom:0;z-index:5;margin-top:20px;padding:10px 0 12px;background-color:var(--bg-color);border-top:1px solid var(--border-color)}
.keyboard.mini{min-width:0;max-width:760px;margin:0 auto;aspect-ratio:15/5}
.keyboard.mini .key>span{font-size:1.7cqw}
.ms-top{margin-top:40px;padding-top:30px;border-top:1px solid var(--border-color)}
.ms-area{display:flex;gap:30px;align-items:center;padding:25px;border:2px dashed var(--border-color);border-radius:12px;background-color:var(--bg-color);user-select:none;-webkit-user-select:none;cursor:crosshair;flex-wrap:wrap}
.ms-svg{width:150px;flex-shrink:0;margin:0 auto}
.ms-body{fill:var(--key-bg);stroke:var(--key-shadow);stroke-width:2}
.ms-part{fill:var(--key-bg);stroke:var(--border-color);stroke-width:1;transition:fill .08s}
.ms-part.tested{fill:var(--key-tested-bg);stroke:var(--key-tested-border)}
.ms-part.pressed{fill:var(--primary-color)}
.ms-line{stroke:var(--key-shadow);stroke-width:2}
.ms-arrow{fill:var(--border-color);transition:fill .1s}
.ms-arrow.tested{fill:var(--key-tested-border)}
.ms-arrow.flash{fill:var(--primary-color)}
.ms-label{fill:var(--ui-text);font-size:14px;font-weight:700;text-anchor:middle;pointer-events:none}
.ms-side{fill:var(--ui-text);font-size:8px;pointer-events:none}
.ms-info{flex:1;min-width:260px}
.ms-table{width:100%;border-collapse:collapse;font-size:.9em;margin-bottom:14px;color:var(--text-typed)}
.ms-table th{font-weight:600;color:var(--ui-text);text-align:left;padding:6px 8px;border-bottom:1px solid var(--border-color)}
.ms-table td{padding:6px 8px;border-bottom:1px dashed var(--border-color);font-family:monospace}
.ms-table td:first-child{font-family:inherit}
.ms-table tr.tested td:first-child{color:var(--key-tested-text);font-weight:700}
.ms-table td.warn{color:var(--text-error);font-weight:700}
.ms-stats{margin-bottom:0}
@media (max-width:600px){#section-keyboard{padding:20px}.ms-area{padding:15px}
  nav{gap:6px}
