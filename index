  if (entries['META-INF/container.xml']) { const m = (await read('META-INF/container.xml')).match(/full-path="([^"]+)"/); if (m) root = m[1]; }
  if (!root) root = Object.keys(entries).find(n => /\.(xml|musicxml)$/i.test(n) && !n.startsWith('META-INF'));
