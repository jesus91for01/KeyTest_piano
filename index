/* ===== 성경 필사 ===== */
body{--paper-bg:#fffdf6;--paper-line:#eee4cc;--paper-text:#3b3326;--gold:#f59e0b;--ok:#10b981}
body[data-theme="dark"]{--paper-bg:#1d2129;--paper-line:#343b4a;--paper-text:#e7e1d3}
#section-transcribe{min-height:300px}
.tr-loading{text-align:center;padding:60px 0}
.tr-verbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:16px;font-weight:600;color:var(--text-typed)}
.tr-verbar .tr-tip{font-weight:400}
.tr-data-btns{margin-left:auto;display:flex;gap:8px}
.tr-data-btns .data-btn{padding:6px 12px;font-size:.85em}
.tr-stat-chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
.tr-chip{display:flex;flex-direction:column;background-color:rgba(255,255,255,.15);border-radius:10px;padding:6px 12px;min-width:74px}
.tr-chip span{font-size:.75em;opacity:.85}
.tr-chip strong{font-size:1.15em;font-family:monospace}
.tr-chip small{font-size:.7em;opacity:.8}
/* 타수·정확도 플로팅 창 */
.float-stats{position:fixed;right:16px;top:50%;z-index:900;transform:translate(130%,-50%);opacity:0;pointer-events:none;background-color:var(--box-bg);border:1px solid var(--border-color);border-left:4px solid var(--primary-color);border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,.14);padding:10px 14px;min-width:120px;transition:transform .25s ease,opacity .25s}
.float-stats.show{transform:translate(0,-50%);opacity:.96}
.fs-row{display:flex;justify-content:space-between;align-items:baseline;gap:12px;font-size:.8em;color:var(--ui-text);line-height:1.9}
.fs-row strong{font-family:monospace;font-size:1.3em;color:var(--text-typed)}
.fs-row:first-child strong{color:var(--primary-color)}
@media (max-width:600px){.float-stats{top:8px;right:8px;transform:translateY(-160%);display:flex;gap:10px;padding:6px 10px;min-width:0}.float-stats.show{transform:none}.fs-row{gap:4px;line-height:1.4}.fs-row strong{font-size:1.1em}.tr-data-btns{margin-left:0}}
.tr-paper.en,.tr-votd.en{font-family:Georgia,'Times New Roman',serif}
.tr-hero{display:flex;gap:24px;flex-wrap:wrap;background:linear-gradient(135deg,#3b82f6,#6366f1);color:#fff;border-radius:16px;padding:28px;box-shadow:0 10px 30px rgba(59,130,246,.25)}
.tr-hero-main{flex:1;min-width:240px}
.tr-hero-label{font-weight:700;opacity:.9}
.tr-hero-pct{font-size:3.4em;font-weight:800;line-height:1.1;margin:6px 0 10px;font-family:monospace}
.tr-hero-pct small{font-size:.45em;margin-left:4px}
.tr-bar{height:10px;background-color:rgba(127,127,127,.2);border-radius:5px;overflow:hidden}
.tr-bar>div{height:100%;width:0;background-color:var(--ok);border-radius:5px;transition:width .6s ease}
.tr-hero .tr-bar{background-color:rgba(255,255,255,.25)}
.tr-hero .tr-bar>div{background-color:#fff}
.tr-bar.big{height:14px;border-radius:7px}
.tr-hero-sub{margin-top:10px;font-size:.95em;opacity:.95}
.tr-cheer{margin-top:14px;background-color:rgba(255,255,255,.15);border-radius:10px;padding:10px 14px;font-size:.95em;line-height:1.5}
.tr-hero-side{display:flex;flex-direction:column;align-items:center;gap:8px;min-width:150px;margin:0 auto}
.tr-ring-wrap{position:relative;width:110px;height:110px}
.tr-ring{width:100%;height:100%;transform:rotate(-90deg)}
.tr-ring circle{fill:none;stroke-width:8}
.tr-ring .bg{stroke:rgba(255,255,255,.25)}
.tr-ring .fg{stroke:#fde68a;stroke-linecap:round;stroke-dasharray:238.76;stroke-dashoffset:238.76;transition:stroke-dashoffset .6s}
.tr-ring-text{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1.2}
.tr-ring-text strong{font-size:1.6em}
.tr-ring-text span{font-size:.8em}
.tr-ring-text small{font-size:.75em;opacity:.85}
.tr-goal{font-size:.85em;display:flex;align-items:center;gap:6px}
.tr-goal select{padding:2px 6px;font-size:.95em;border-radius:6px;background-color:rgba(255,255,255,.92);color:#1f2937;border:none}
.tr-resume{display:block;width:100%;margin:18px 0;padding:16px;border-radius:12px;background-color:var(--text-typed);color:var(--box-bg);font-weight:700;font-size:1.1em}
.tr-resume:hover{opacity:.9}
.tr-badges{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px}
.tr-badge{display:inline-flex;align-items:center;gap:4px;padding:5px 11px;border-radius:14px;font-size:.85em;background-color:var(--box-bg);border:1px solid var(--border-color);color:var(--ui-text);opacity:.5;filter:grayscale(1)}
.tr-badge.on{opacity:1;filter:none;background-color:#fef3c7;border-color:var(--gold);color:#92400e;font-weight:700}
body[data-theme="dark"] .tr-badge.on{background-color:#422006;color:#fde68a}
.tr-votd{font-family:'Nanum Myeongjo','Batang','바탕','AppleMyungjo',serif;background-color:var(--paper-bg);color:var(--paper-text);border-left:4px solid var(--gold);border-radius:8px;padding:14px 18px;margin-bottom:10px;line-height:1.7}
.tr-votd small{display:block;margin-top:4px;color:var(--ui-text)}
.tr-h3{color:var(--text-typed);margin:26px 0 10px;font-size:1.1em}
.tr-h3 small{font-weight:400;color:var(--ui-text);font-size:.8em;margin-left:6px}
.tr-books{display:grid;grid-template-columns:repeat(auto-fill,minmax(112px,1fr));gap:8px}
.tr-book{position:relative;text-align:left;padding:10px 12px 12px;border-radius:10px;background-color:var(--box-bg);border:1px solid var(--border-color);overflow:hidden}
.tr-book:hover{border-color:var(--primary-color)}
.tr-book .name{display:block;font-weight:700;color:var(--text-typed);font-size:.95em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tr-book .name.long{font-size:.8em;letter-spacing:-.5px;line-height:1.5}
.tr-book .pct{display:block;font-size:.75em;margin:2px 0 6px;font-family:monospace}
.tr-book .tr-bar{height:5px}
.tr-book.started{background-image:linear-gradient(0deg,rgba(16,185,129,.1),transparent)}
.tr-book.full{border:2px solid var(--gold);background-color:#fffbeb}
.tr-book.full .name::after{content:' 👑'}
body[data-theme="dark"] .tr-book.full{background-color:#2a2111}
.tr-topbar{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:12px}
.tr-topbar h2{margin:0;color:var(--text-typed);font-size:1.3em}
.tr-sub{font-size:.9em}
.tr-tip{font-size:.85em;color:var(--ui-text)}
.tr-chapter-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(52px,1fr));gap:6px;margin-top:10px}
.tr-ch{--p:0%;height:46px;border-radius:8px;border:1px solid var(--border-color);font-weight:700;color:var(--text-typed);background:linear-gradient(0deg,rgba(16,185,129,.4) var(--p),var(--box-bg) var(--p))}
.tr-ch:hover{border-color:var(--primary-color)}
.tr-ch.full{background:var(--ok);color:#fff;border-color:var(--ok)}
.tr-ch.full::after{content:' ✓'}
.tr-ch.last{outline:2px solid var(--primary-color);outline-offset:1px}
.tr-live{display:flex;gap:14px;margin-left:auto;font-family:monospace}
.tr-live strong{color:var(--text-typed)}
#tr-verse-select{padding:6px 10px}
.tr-chapter-progress{display:flex;align-items:center;gap:10px;margin-bottom:14px}
.tr-chapter-progress .tr-bar{flex:1}
.tr-chapter-progress span{font-size:.85em;white-space:nowrap;font-family:monospace}
.tr-paper{background-color:var(--paper-bg);color:var(--paper-text);border-radius:12px;padding:22px 26px;font-family:'Nanum Myeongjo','Batang','바탕','AppleMyungjo',serif;font-size:1.25em;line-height:1.9;box-shadow:inset 0 0 0 1px var(--paper-line)}
.tr-row{display:flex;gap:12px;padding:8px 0;border-bottom:1px dashed var(--paper-line)}
.tr-row .vn{flex:0 0 2.4em;text-align:right;font-size:.72em;color:var(--ui-text);padding-top:.45em;font-family:monospace;white-space:nowrap}
.tr-row .vbody{flex:1;min-width:0;word-break:keep-all}
.tr-row.todo,.tr-row.done{cursor:pointer}
.tr-row.todo .vt{opacity:.45}
.tr-row.done .vt{font-weight:700;opacity:1}
.tr-row.done .vn::before{content:'✓ ';color:var(--ok)}
.tr-row.auto .vt{opacity:.35;font-size:.8em;font-style:italic}
.tr-row.current{background-color:rgba(59,130,246,.07);border-radius:8px;border-bottom-color:transparent;padding:10px 8px;margin:4px -8px}
.tr-row.current .vt span{color:var(--text-untyped)}
.tr-row.current .vt span.ok{color:var(--paper-text)}
.tr-row.current .vt span.bad{color:var(--text-error);background-color:var(--bg-error);border-radius:2px}
.tr-row.current .vt span.comp{color:var(--paper-text);border-bottom:2px solid var(--paper-text)}
.tr-row.current .vt span.cur{box-shadow:-2px 0 0 var(--caret-color)}
.tr-input{display:block;width:100%;box-sizing:border-box;margin-top:8px;padding:8px 10px;border:none;border-bottom:2px solid var(--primary-color);border-radius:6px 6px 0 0;background-color:rgba(127,127,127,.07);color:var(--paper-text);font:inherit;line-height:1.7;resize:none;overflow:hidden;outline:none;min-height:0}
.tr-hint{font-size:.7em;margin-top:6px;color:var(--ui-text);font-family:-apple-system,'Segoe UI',sans-serif;min-height:1.2em}
.tr-hint.warn{color:var(--text-error)}
.tr-writer-nav{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:16px;flex-wrap:wrap}
.tr-toast{position:fixed;left:50%;bottom:30px;transform:translateX(-50%) translateY(20px);background-color:var(--text-typed);color:var(--box-bg);padding:10px 18px;border-radius:20px;font-weight:600;opacity:0;pointer-events:none;transition:all .25s;z-index:1200;max-width:90vw;text-align:center}
.tr-toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
.tr-celebrate-box{text-align:center;overflow:hidden}
.tr-cele-emoji{font-size:4em;animation:trPop .5s ease}
@keyframes trPop{0%{transform:scale(.3)}70%{transform:scale(1.15)}100%{transform:scale(1)}}
.tr-btns{display:flex;gap:8px;margin-top:18px;position:relative;z-index:1}
.tr-btns button{flex:1;padding:12px;border-radius:8px;font-weight:700;border:1px solid var(--border-color);background-color:var(--bg-color);color:var(--text-typed)}
.tr-btns button.primary{background-color:var(--primary-color);border-color:var(--primary-color);color:#fff}
.tr-confetti{position:absolute;inset:0;pointer-events:none;overflow:hidden}
.tr-confetti i{position:absolute;top:-14px;width:8px;height:12px;border-radius:2px;animation:trFall linear forwards}
@keyframes trFall{to{transform:translateY(460px) rotate(560deg);opacity:.15}}
@media (max-width:600px){.tr-hero{padding:20px}.tr-hero-pct{font-size:2.6em}.tr-paper{padding:14px 12px;font-size:1.1em}.tr-live{margin-left:0}.tr-books{grid-template-columns:repeat(auto-fill,minmax(96px,1fr))}}
</style>
</head>
<body>
<header>
  <h1>📖 성경 타자 연습</h1>
  <div class="header-btns"><button id="help-toggle">❓ 사용법</button><button id="theme-toggle">🌙 Dark</button></div>
</header>
<nav><button id="tab-practice" class="active">성경 타자 연습</button><button id="tab-transcribe">성경 필사</button><button id="tab-manage">나만의 말씀 노트</button><button id="tab-keyboard">키보드·마우스 테스트</button></nav>
<main>
  <section id="section-manage" style="display:none">
    <div class="manage-header">
      <h2>나만의 말씀 노트</h2>
      <div class="data-btns">
        <button id="btn-backup" class="data-btn">💾 백업</button>
        <button id="btn-restore" class="data-btn">📂 불러오기</button>
        <input type="file" id="file-restore" accept=".json" style="display:none">
      </div>
    </div>
    <div class="input-group">
      <div class="bible-lookup">
        <div class="lookup-title"><span>📖 성경(개역한글)에서 불러오기</span><span id="lookup-status"></span></div>
        <div class="lookup-row">
          <select id="lk-book" disabled></select>
          <select id="lk-chapter" disabled></select><span id="lk-chapter-unit">장</span>
          <select id="lk-vstart" disabled></select><span>절 ~</span>
          <select id="lk-vend" disabled></select><span>절</span>
          <button id="lk-load" class="sub-btn" disabled>불러오기</button>
        </div>
        <div class="lookup-hint">또는 아래 장절 칸에 <strong>요 3:16</strong>, <strong>롬 8:28~30</strong>, <strong>시 23편</strong>처럼 입력하고 [본문 찾기]를 누르세요.</div>
      </div>
      <input type="text" id="verse-chapter" list="chapter-list" placeholder="챕터 / 분류 (예: 암송 1주차)">
      <datalist id="chapter-list"></datalist>
      <div class="ref-row">
        <input type="text" id="verse-ref" placeholder="장절 (예: 요한복음 3:16)">
        <button id="btn-find-ref" class="sub-btn">본문 찾기</button>
      </div>
      <textarea id="verse-text" placeholder="암송할 말씀을 입력하세요 (위에서 불러오면 자동으로 채워집니다)"></textarea>
      <button id="add-verse-btn">말씀 추가하기</button>
    </div>
    <div id="verse-list"></div>
  </section>

  <section id="section-practice">
    <div class="practice-header">
      <div class="chapter-selector"><select id="chapter-select"></select></div>
      <div class="minimal-stats">
        <span>타수 <strong id="wpm-display">0</strong></span>
        <span>정확도 <strong id="accuracy-display">100</strong>%</span>
        <span style="margin-left:10px;color:var(--primary-color)" id="progress-text">1/1</span>
      </div>
      <div class="toggles-group">
        <div class="lang-switch" id="lang-switch">
          <button data-lang="ko">한글</button><button data-lang="en">English</button>
        </div>
        <label style="cursor:pointer;display:flex;align-items:center;gap:5px;color:var(--primary-color);font-weight:700"><input type="checkbox" id="repeat-toggle"> 🔁 반복</label>
        <label style="cursor:pointer;display:flex;align-items:center;gap:5px"><input type="checkbox" id="blind-toggle"> 🙈 블라인드</label>
        <label style="cursor:pointer;display:flex;align-items:center;gap:5px"><input type="checkbox" id="kbview-toggle"> ⌨️ 키보드 보기</label>
        <span class="sound-ctrl" id="sound-ctrl">
          <label style="cursor:pointer;display:flex;align-items:center;gap:5px"><input type="checkbox" id="sound-toggle"> 🔊 피아노 소리</label>
          <input type="range" id="sound-vol" min="5" max="100" value="80" title="소리 크기">
          <label class="song-ctl-toggle" style="cursor:pointer;display:flex;align-items:center;gap:5px"><input type="checkbox" id="song-toggle"> 🎼 연주 모드</label>
          <select id="song-select" class="song-ctl" title="연주할 곡"></select>
          <button id="song-edit" class="data-btn song-ctl song-edit-btn" type="button">✏️ 곡 편집</button>
          <span id="song-progress" class="song-ctl song-progress"></span>
        </span>
      </div>
    </div>
    <div class="typing-container" id="typing-container">
      <div id="current-ref">말씀을 불러오는 중...</div>
      <div id="typing-display" class="typing-area"></div>
      <textarea id="user-input" class="hidden-textarea" autocomplete="off" spellcheck="false" autocapitalize="off" autocorrect="off"></textarea>
    </div>
    <p id="feedback-msg" class="feedback-msg"></p>
    <button id="btn-mobile-next" class="btn-mobile-next">다음 구절로 넘어가기 (터치/Enter)</button>
    <div class="verse-nav-btns">
      <button id="btn-prev-verse" class="nav-btn">← 이전 구절</button>
      <button id="btn-next-verse" class="nav-btn">다음 구절 →</button>
    </div>
    <div class="practice-kb" id="practice-kb" style="display:none"><div class="keyboard mini" id="practice-keyboard"></div></div>
  </section>

  <section id="section-transcribe" style="display:none">
    <div class="tr-verbar">
      <span>📖 번역본</span>
      <div class="lang-switch" id="tr-ver"><button data-ver="ko" type="button">개역한글</button><button data-ver="en" type="button">NKJV (영어)</button></div>
      <span class="tr-tip">번역본마다 필사 기록이 따로 저장됩니다</span>
      <span class="tr-data-btns">
        <button id="tr-backup" class="data-btn" type="button">💾 필사 기록 백업</button>
        <button id="tr-restore" class="data-btn" type="button">📂 불러오기</button>
        <input type="file" id="tr-restore-file" accept=".json" style="display:none">
      </span>
    </div>
    <div id="tr-loading" class="tr-loading">성경 데이터를 불러오는 중...</div>

    <div id="tr-home" style="display:none">
      <div class="tr-hero">
        <div class="tr-hero-main">
          <div class="tr-hero-label" id="tr-hero-label">📜 성경 전체 필사</div>
          <div class="tr-hero-pct"><span id="tr-pct">0</span><small>%</small></div>
          <div class="tr-bar big"><div id="tr-bar"></div></div>
          <div class="tr-hero-sub"><strong id="tr-done-count">0</strong> / <span id="tr-total">0</span>절 필사</div>
          <div class="tr-stat-chips">
            <div class="tr-chip"><span>구약</span><strong id="tr-ot">0%</strong></div>
            <div class="tr-chip"><span>신약</span><strong id="tr-nt">0%</strong></div>
            <div class="tr-chip"><span>📅 필사 기간</span><strong id="tr-period">-</strong><small id="tr-period-sub"></small></div>
            <div class="tr-chip"><span>⌨️ 평균 타수</span><strong id="tr-avg-cpm">-</strong></div>
            <div class="tr-chip"><span>🎯 평균 정확도</span><strong id="tr-avg-acc">-</strong></div>
          </div>
          <div class="tr-cheer" id="tr-cheer"></div>
        </div>
        <div class="tr-hero-side">
          <div class="tr-ring-wrap">
            <svg class="tr-ring" viewBox="0 0 90 90"><circle class="bg" cx="45" cy="45" r="38"/><circle class="fg" id="tr-ring-fg" cx="45" cy="45" r="38"/></svg>
            <div class="tr-ring-text"><strong id="tr-today">0</strong><span>/ <span id="tr-goal-num">10</span>절</span><small>오늘</small></div>
          </div>
          <div>🔥 <strong id="tr-streak">0</strong>일 연속</div>
          <label class="tr-goal">하루 목표
            <select id="tr-goal"><option>5</option><option>10</option><option>20</option><option>30</option><option>50</option><option>100</option></select>절
          </label>
        </div>
      </div>
      <button id="tr-resume" class="tr-resume" type="button"></button>
      <div class="tr-badges" id="tr-badges"></div>
      <div class="tr-votd" id="tr-votd"></div>
      <h3 class="tr-h3">구약 <small id="tr-ot-sub"></small></h3>
      <div class="tr-books" id="tr-books-ot"></div>
      <h3 class="tr-h3">신약 <small id="tr-nt-sub"></small></h3>
      <div class="tr-books" id="tr-books-nt"></div>
    </div>

    <div id="tr-book" style="display:none">
      <div class="tr-topbar">
        <button class="nav-btn" id="tr-book-back" type="button">← 전체 보기</button>
        <h2 id="tr-book-title"></h2>
        <span id="tr-book-sub" class="tr-sub"></span>
      </div>
      <div class="tr-bar"><div id="tr-book-bar"></div></div>
      <p class="tr-tip">필사할 장을 고르세요. 이미 쓴 절은 건너뛰고, 아직 쓰지 않은 첫 절부터 시작합니다. (파란 테두리 = 마지막으로 쓰던 장)</p>
      <div class="tr-chapter-grid" id="tr-chapter-grid"></div>
    </div>

    <div id="tr-writer" style="display:none">
      <div class="tr-topbar">
        <button class="nav-btn" id="tr-writer-back" type="button">← 목록</button>
        <h2 id="tr-writer-title"></h2>
        <select id="tr-verse-select" title="절 선택"></select>
        <div class="tr-live"><span>타수 <strong id="tr-cpm">0</strong></span><span>정확도 <strong id="tr-acc">100</strong>%</span></div>
      </div>
      <div class="tr-chapter-progress"><div class="tr-bar"><div id="tr-ch-bar"></div></div><span id="tr-ch-text"></span></div>
      <div class="tr-paper" id="tr-paper"></div>
