    const o = document.createElement('option');
    o.value = i + 1;
    o.textContent = `${i + 1}절${trIsDone(b, c, i + 1) ? ' ✓' : ''}`;
    trVerseSelect.appendChild(o);
  });
  trPaper.innerHTML = '';
  trState.rows = texts.map((t, i) => {
    const ok = trState.cnt[i];
    const row = el('div', 'tr-row ' + (!ok ? 'auto' : trIsDone(b, c, i + 1) ? 'done' : 'todo'));
    row.appendChild(el('span', 'vn', String(i + 1)));
    const body = el('div', 'vbody');
    body.appendChild(el('div', 'vt', ok ? t : t ? '(앞 절과 같은 본문)' : '(본문 없음)'));
    row.appendChild(body);
    if (ok) row.addEventListener('click', () => { if (trState.v !== i + 1) trGo(i + 1); else trInput.focus(); });
    trPaper.appendChild(row);
    return row;
  });
  $('tr-prev-ch').disabled = !trPrevChapter(b, c);
  $('tr-next-ch').disabled = !trNextChapter(b, c);
  trGo(v && trState.cnt[v - 1] ? v : trFirstUndone(b, c));
}
function trGo(v) {
  const s = trState;
  if (!s) return;
  if (s.v) {
    const old = s.rows[s.v - 1];
    old.classList.remove('current');
    old.classList.add(trIsDone(s.b, s.c, s.v) ? 'done' : 'todo');
    old.querySelector('.vt').textContent = s.texts[s.v - 1];
  }
  s.v = v; s.busy = false;
  const row = s.rows[v - 1], vt = row.querySelector('.vt');
  row.classList.remove('todo', 'done');
  row.classList.add('current');
  vt.textContent = '';
  s.target = s.texts[v - 1];
  s.spans = s.target.split('').map(ch => vt.appendChild(el('span', null, ch)));
  row.querySelector('.vbody').append(trInput, trHint);
  trInput.value = ''; trStart = null; trComposing = false;
  trHint.textContent = ''; trHint.classList.remove('warn');
  trVerseSelect.value = v;
  trUpdateChapterBar();
  trRender();
  trAutosize();
  try { trInput.focus({ preventScroll: true }); } catch (e) { trInput.focus(); }
  row.scrollIntoView({ block: 'center' });
}
function trUpdateChapterBar() {
  const p = trChProg(trState.b, trState.c);
  $('tr-ch-bar').style.width = trPct(p.d, p.t) + '%';
  $('tr-ch-text').textContent = `${p.d} / ${p.t}절 (${trPctText(p.d, p.t)}%)`;
}
function trRender() {
  const s = trState, typed = trInput.value;
  let correct = 0, keys = 0;
  s.spans.forEach((sp, i) => {
    const t = typed[i];
    sp.className = '';
    if (t == null) return;
    if (t === s.target[i]) { sp.className = 'ok'; correct++; keys += keyCount(t); }
    else if (trComposing && i === typed.length - 1) sp.className = 'comp';
    else sp.className = 'bad';
  });
  if (typed.length < s.spans.length) s.spans[typed.length].classList.add('cur');
  if (trStart) $('tr-cpm').textContent = Math.round(keys / Math.max((Date.now() - trStart) / 60000, 1 / 60));
  else $('tr-cpm').textContent = '0';
  $('tr-acc').textContent = typed.length ? Math.round(correct / typed.length * 100) : 100;
  return { correct, keys };
}
function trAutosize() { trInput.style.height = 'auto'; trInput.style.height = trInput.scrollHeight + 'px'; }
function trOnInput() {
  const s = trState;
  if (!s || s.busy) return;
  let v = trInput.value.replace(/[\r\n]/g, '');
  if (v.length > s.target.length) v = v.slice(0, s.target.length);
  if (v !== trInput.value) trInput.value = v;
  if (!trStart && v) trStart = Date.now();
  trRender();
  trAutosize();
  trHint.classList.remove('warn');
  if (v.length === s.target.length) {
    if (v === s.target) {
      if (!trComposing) trComplete();
      else trHint.textContent = '✨ Enter를 누르면 완료됩니다';
    } else {
      const bad = [...v].filter((ch, i) => ch !== s.target[i]).length;
      trHint.textContent = `🚨 오타 ${bad}개 · 고치거나 Enter로 넘어가기`;
      trHint.classList.add('warn');
    }
  } else trHint.textContent = '';
}
trInput.addEventListener('compositionstart', () => { trComposing = true; });
trInput.addEventListener('compositionend', () => { trComposing = false; trOnInput(); });
trInput.addEventListener('input', trOnInput);
trInput.addEventListener('keydown', e => {
  if (e.key !== 'Enter') return;
  e.preventDefault();
  const v = trState && trState.v;
  if (e.isComposing || e.keyCode === 229) setTimeout(() => trTryEnter(v), 30); // 한글 조합이 끝난 뒤 확인
  else trTryEnter(v);
});
function trTryEnter(v) {
  const s = trState;
  if (!s || s.busy || s.v !== v) return;
  if (trInput.value.length >= s.target.length) trComplete();
  else { trHint.textContent = '끝까지 써야 다음 절로 넘어갈 수 있어요 ✍️'; trHint.classList.add('warn'); }
}
trInput.addEventListener('paste', e => { e.preventDefault(); trToast('필사는 한 글자씩 직접 써 주세요 ✍️'); });
trInput.addEventListener('drop', e => e.preventDefault());

function trComplete() {
  const s = trState;
  if (!s || s.busy) return;
  s.busy = true;
  const { correct, keys } = trRender(), typed = trInput.value, ms = trStart ? Date.now() - trStart : 0;
  const acc = typed.length ? Math.round(correct / typed.length * 100) : 100;
  trMarkDone(s.b, s.c, s.v);
  const V = TV(), st = V.stats, dk = trDayKey(new Date());
  st.verses++; st.typed += typed.length; st.correct += correct;
  if (ms >= 500) { st.keys += keys; st.ms += ms; } // 너무 짧은 기록은 평균 타수에서 제외
  V.days[dk] = (V.days[dk] || 0) + 1;
  tr.days[dk] = (tr.days[dk] || 0) + 1;
  const opt = trVerseSelect.querySelector(`option[value="${s.v}"]`);
  if (opt) opt.textContent = `${s.v}절 ✓`;
  const summary = trSummary(), fresh = trCheckBadges(summary), goal = +tr.goal || 10;
  let msg = `✨ ${s.v}절 완료 · 정확도 ${acc}%`;
  if (tr.days[dk] === goal) msg = `🎯 오늘 목표 ${goal}절 달성! 정말 잘하셨어요`;
  if (fresh.length) msg = `🏅 새 배지 '${fresh[fresh.length - 1][2]}' 획득!`;
  trToast(msg);
  let next = 0;
  for (let i = s.v; i < s.cnt.length; i++) if (s.cnt[i]) { next = i + 1; break; }
  const cp = trChProg(s.b, s.c), nch = trNextChapter(s.b, s.c);
  if (!next && cp.d < cp.t) { next = trFirstUndone(s.b, s.c); trToast('이 장에서 아직 쓰지 않은 절로 이동합니다'); }
  // 다음에 이어서 쓸 위치 저장 (장을 열어 보기만 해서는 바뀌지 않음)
  TV().last = next ? { b: s.b, c: s.c, v: next } : nch ? { b: nch[0], c: nch[1], v: 1 } : { b: s.b, c: s.c, v: s.v };
  saveTr();
  if (next) { trGo(next); return; }
  trChapterDone(summary);
}
function trChapterDone(summary) {
  const s = trState, row = s.rows[s.v - 1];
  row.classList.remove('current');
  row.classList.add('done');
  row.querySelector('.vt').textContent = s.target;
  trInput.remove(); trHint.remove();
  s.v = 0;
  trUpdateChapterBar();
  const bp = trBookProg(s.b), bookFull = bp.t && bp.d === bp.t, name = trBookName(s.b);
  const title = bookFull ? `${name} 완필! 👑` : `${trChLabel(s.b, s.c)} 완필!`;
  const text = (bookFull ? `${name} ${bp.chapters}${trUnit(s.b)}을 모두 손으로 써 내려갔습니다. ` : '')
    + `지금까지 ${trVerName()} 성경 ${trFmt(summary.done)}절 (${trPctText(summary.done, TR_TOTAL)}%)을 필사했어요.`;
  trCelebrate(bookFull ? '👑' : '🎉', title, text, trNextChapter(s.b, s.c));
}
function trCelebrate(emoji, title, text, next) {
  $('tr-cele-emoji').textContent = emoji;
  $('tr-cele-title').textContent = title;
  $('tr-cele-text').textContent = text;
  const nb = $('tr-cele-next');
  nb.style.display = next ? '' : 'none';
  if (next) nb.textContent = `${trChLabel(next[0], next[1])} 계속 ▶`;
  trCeleNext = next;
  const conf = $('tr-confetti'), colors = ['#f59e0b', '#3b82f6', '#10b981', '#ef4444', '#8b5cf6', '#ec4899'];
  conf.innerHTML = '';
  for (let i = 0; i < 40; i++) {
    const p = document.createElement('i');
    p.style.left = Math.random() * 100 + '%';
    p.style.background = colors[i % colors.length];
    p.style.animationDuration = (1.2 + Math.random() * 1.6) + 's';
    p.style.animationDelay = Math.random() * 0.4 + 's';
    conf.appendChild(p);
  }
  $('tr-celebrate').classList.add('show');
}
$('tr-cele-next').addEventListener('click', () => { $('tr-celebrate').classList.remove('show'); if (trCeleNext) trOpen(trCeleNext[0], trCeleNext[1]); });
$('tr-cele-list').addEventListener('click', () => { $('tr-celebrate').classList.remove('show'); trOpenBook(trState ? trState.b : 0); });
trVerseSelect.addEventListener('change', e => trGo(+e.target.value));
$('tr-prev-ch').addEventListener('click', () => { const p = trPrevChapter(trState.b, trState.c); if (p) trOpen(p[0], p[1]); });
$('tr-next-ch').addEventListener('click', () => { const p = trNextChapter(trState.b, trState.c); if (p) trOpen(p[0], p[1]); });
$('tr-writer-back').addEventListener('click', () => trOpenBook(trState ? trState.b : 0));
$('tr-book-back').addEventListener('click', () => { trView('home'); trRenderHome(); window.scrollTo(0, 0); });
$('tr-resume').addEventListener('click', () => {
  const L = TV().last;
  if (L && TR_META[L.b] && TR_META[L.b][L.c - 1]) trOpen(L.b, L.c, L.v); else trOpen(0, 1);
});
$('tr-goal').addEventListener('change', e => { tr.goal = +e.target.value; saveTr(); trRenderHome(); });

// ===== 필사 기록 백업·불러오기 =====
$('tr-backup').addEventListener('click', () => {
  const data = { type: 'BibleTranscriptionBackup', version: 2, savedAt: new Date().toISOString(), data: tr };
  const a = document.createElement('a');
  a.href = 'data:application/json;charset=utf-8,' + encodeURIComponent(JSON.stringify(data));
  a.download = `성경필사_백업_${trDayKey(new Date())}.json`;
  document.body.appendChild(a); a.click(); a.remove();
  trToast('💾 필사 기록을 파일로 저장했습니다');
});
$('tr-restore').addEventListener('click', () => $('tr-restore-file').click());
// 두 기록 합치기: 쓴 절은 어느 쪽이든 쓴 것으로, 날짜별·통계는 큰 값으로
function trMerge(a, b) {
  ['ko', 'en'].forEach(k => {
    const A = a.v[k], B = b.v[k];
    Object.entries(B.done).forEach(([key, s]) => {
      const cur = A.done[key] || '', n = Math.max(cur.length, s.length);
      let out = '';
      for (let i = 0; i < n; i++) out += cur[i] === '1' || s[i] === '1' ? '1' : '0';
      A.done[key] = out;
    });
    A.badges = [...new Set([...A.badges, ...B.badges])];
    Object.entries(B.days).forEach(([d, n]) => { A.days[d] = Math.max(A.days[d] || 0, n); });
    if (B.stats.verses > A.stats.verses) A.stats = B.stats;
    if (!A.last) A.last = B.last;
  });
  Object.entries(b.days).forEach(([d, n]) => { a.days[d] = Math.max(a.days[d] || 0, n); });
  return a;
}
$('tr-restore-file').addEventListener('change', e => {
  const f = e.target.files[0];
  e.target.value = '';
  if (!f) return;
  const r = new FileReader();
  r.onload = ev => {
    let raw;
    try { raw = JSON.parse(ev.target.result); } catch (err) { alert('파일을 읽는 중 오류가 발생했습니다.'); return; }
    const src = raw && raw.type === 'BibleTranscriptionBackup' ? raw.data : raw;
    if (!src || typeof src !== 'object' || !(src.v || src.done)) { alert('성경 필사 백업 파일이 아닙니다.\n(말씀 노트 백업은 [나만의 말씀 노트]에서 불러오세요.)'); return; }
    const incoming = trNormalize(src);
    const count = o => ['ko', 'en'].map(k => Object.values(o.v[k].done).reduce((n, s) => n + (s.match(/1/g) || []).length, 0));
    const [ik, ie] = count(incoming);
    const overwrite = confirm(`백업 파일: 개역한글 ${trFmt(ik)}절 · NKJV ${trFmt(ie)}절\n\n기존 필사 기록을 지우고 백업 파일로 덮어씌우시겠습니까?\n\n[확인] : 기존 기록 삭제 후 복원\n[취소] : 기존 기록에 합치기 (병합)`);
    const ver = tr.ver;
    tr = overwrite ? incoming : trMerge(tr, incoming);
    tr.ver = ver;
    saveTr();
    trState = null;
    trView('home'); trRenderHome();
    trToast(overwrite ? '📂 백업 파일로 복원했습니다' : '📂 백업 기록을 합쳤습니다');
  };
  r.readAsText(f);
});

async function trEnter() {
  trUpdateVerButtons();
  if (!(await trEnsureData())) {
    if (!trEn()) return;
    alert($('tr-loading').textContent + '\n개역한글로 전환합니다.'); // 영어 데이터가 없으면 개역한글로
    tr.ver = 'ko'; saveTr(); trUpdateVerButtons();
    if (!(await trEnsureData())) return;
  }
  if (trViews.writer.style.display === 'block' && trState && trState.v) { // 쓰던 화면으로 돌아옴
    try { trInput.focus({ preventScroll: true }); } catch (e) { trInput.focus(); }
    return;
  }
  trView('home');
  trRenderHome();
}
tabTranscribe.addEventListener('click', () => { showSection('transcribe'); trEnter(); });

// ===== 타수·정확도 플로팅 창: 긴 본문을 치다 위쪽 기록이 화면 밖으로 나가면 오른쪽에 따라다님 =====
const floatStats = $('float-stats');
function floatSource() {
  if (secPractice.style.display !== 'none' && current) {
    return { anchor: document.querySelector('#section-practice .minimal-stats'), cpm: wpmDisplay.textContent, acc: accuracyDisplay.textContent, prog: progressText.textContent.replace(/\s*\(.*\)$/, ''), label: '구절' };
  }
  if (secTranscribe.style.display === 'block' && trViews.writer.style.display === 'block' && trState) {
    return { anchor: document.querySelector('#tr-writer .tr-live'), cpm: $('tr-cpm').textContent, acc: $('tr-acc').textContent, prog: $('tr-ch-text').textContent.replace(/\s*\(.*\)$/, ''), label: '이 장' };
  }
  return null;
}
function updateFloat() {
  const s = floatSource();
  let show = false;
  if (s && s.anchor) {
    const r = s.anchor.getBoundingClientRect();
    const vh = window.innerHeight || document.documentElement.clientHeight;
    show = r.bottom < 4 || (vh > 0 && r.top > vh);
    if (show) {
      $('fs-cpm').textContent = s.cpm;
      $('fs-acc').textContent = s.acc + '%';
      $('fs-prog').textContent = s.prog;
      $('fs-prog-label').textContent = s.label;
    }
  }
  floatStats.classList.toggle('show', show);
}
let floatTimer = 0;
const scheduleFloat = () => { if (!floatTimer) floatTimer = setTimeout(() => { floatTimer = 0; updateFloat(); }, 40); };
window.addEventListener('scroll', scheduleFloat, { passive: true });
window.addEventListener('resize', scheduleFloat);
new MutationObserver(scheduleFloat).observe(document.body, { subtree: true, childList: true, characterData: true, attributes: true, attributeFilter: ['style'] });

document.addEventListener('DOMContentLoaded', init);
