function renderTyping() {
  const target = current.text, typed = userInput.value;
  const spans = typingDisplay.querySelectorAll('span:not(.end-caret)'), endCaret = typingDisplay.querySelector('.end-caret');
  let correct = 0, keys = 0;
  spans.forEach((s, i) => {
    const t = typed[i];
    s.classList.remove('correct', 'incorrect', 'current-char', 'composing');
    s.removeAttribute('data-typed');
    if (t == null) return;
    if (t === s.innerText) { s.classList.add('correct'); correct++; keys += keyCount(t); }
    else if (isComposing && i === typed.length - 1) s.classList.add('composing');
    else { s.classList.add('incorrect'); s.dataset.typed = t === ' ' ? '␣' : t; }
  });
  endCaret.classList.remove('current-char');
  (typed.length < target.length ? spans[typed.length] : endCaret).classList.add('current-char');
  updateStats(keys, correct, typed.length);
  syncCaret(true);
}

// ===== 자동 스크롤: 입력창을 커서 위치로 옮기고, 커서가 화면 밖으로 나가면 따라 내려감 =====
function viewportHeight() { return window.visualViewport ? window.visualViewport.height : window.innerHeight; }
function syncCaret(scroll) {
  const caret = typingDisplay.querySelector('.current-char');
  if (!caret || secPractice.style.display === 'none') return;
  const cr = caret.getBoundingClientRect(), br = typingContainer.getBoundingClientRect();
  if (!isComposing) {
    userInput.style.top = (cr.top - br.top) + 'px';
    userInput.style.left = Math.max(0, Math.min(cr.left - br.left, br.width - 24)) + 'px';
    userInput.style.height = Math.max(cr.height, 20) + 'px';
  }
  if (!scroll) return;
  const offset = window.visualViewport ? window.visualViewport.offsetTop : 0;
  let vh = viewportHeight();
  // 키보드 보기가 화면 아래에 붙어 있으면 그 위까지만 보이는 영역으로 계산
  if (practiceKb.style.display !== 'none') {
    const kr = practiceKb.getBoundingClientRect();
    if (kr.bottom - offset >= vh - 2) vh = Math.max(100, kr.top - offset);
  }
  const top = cr.top - offset, bottom = cr.bottom - offset;
  const margin = Math.min(140, vh * 0.25);
  if (bottom > vh - margin) window.scrollBy(0, bottom - vh * 0.6);
  else if (top < 10) window.scrollBy(0, top - vh * 0.3);
}
window.addEventListener('resize', () => syncCaret(false));
if (window.visualViewport) window.visualViewport.addEventListener('resize', () => syncCaret(true)); // 모바일 키보드

